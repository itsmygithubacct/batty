+test "placement_set_position preserves cursor and survives separate-region scroll" {
+    if (comptime !build_options.kitty_graphics) return error.SkipZigTest;
+
+    var t: terminal_c.Terminal = null;
+    try testing.expectEqual(Result.success, terminal_c.new(
+        &lib.alloc.test_allocator,
+        &t,
+        80,
+        24,
+    ));
+    defer terminal_c.free(t);
+    const setup = "\x1b[2;3H\x1b7\x1b[5;10r\x1b[?6h\x1b[3;80HX" ++
+        "\x1b_Ga=T,t=d,f=24,i=1,p=1,C=1,s=1,v=2;////////\x1b\\";
+    terminal_c.vt_write(t, setup.ptr, setup.len);
+    const terminal = t.?.terminal;
+    const screen = terminal.screens.active;
+    const storage = &screen.kitty_images;
+    const saved = screen.saved_cursor;
+    const tracked_count = screen.pages.countTrackedPins();
+    const generation = storage.generation;
+    try testing.expect(screen.cursor.pending_wrap);
+    try testing.expectEqual(Result.success, placement_set_position(t, 1, 1, 0, 0));
+    try testing.expectEqual(79, screen.cursor.x);
+    try testing.expectEqual(6, screen.cursor.y);
+    try testing.expect(screen.cursor.pending_wrap);
+    try testing.expect(terminal.modes.get(.origin));
+    try testing.expectEqualDeep(saved, screen.saved_cursor);
+    try testing.expectEqual(tracked_count, screen.pages.countTrackedPins());
+    try testing.expect(storage.generation != generation and storage.dirty);
