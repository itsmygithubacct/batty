+/// Move an explicit, pin-backed placement in active-screen coordinates.
+/// This does not execute cursor movement or change any saved cursor state.
+pub fn placement_set_position(
+    terminal_: terminal_c.Terminal,
+    image_id: u32,
+    placement_id: u32,
+    column: u16,
+    row: u16,
+) callconv(lib.calling_conv) Result {
+    if (comptime !build_options.kitty_graphics) return .no_value;
+
+    const wrapper = terminal_ orelse return .invalid_value;
+    const terminal = wrapper.terminal;
+    if (image_id == 0 or placement_id == 0 or
+        column >= terminal.cols or row >= terminal.rows) return .invalid_value;
+
+    const screen = terminal.screens.active;
+    const storage = &screen.kitty_images;
+    const placement = storage.placements.getPtr(.{
+        .image_id = image_id,
+        .placement_id = .{ .tag = .external, .id = placement_id },
+    }) orelse return .no_value;
+    const pin = switch (placement.location) {
+        .pin => |pin| pin,
+        .relative, .virtual => return .invalid_value,
+    };
+    const destination = screen.pages.pin(.{ .active = .{
+        .x = column,
+        .y = row,
+    } }) orelse return .invalid_value;
+
+    // Reuse the existing tracked pin so relocation requires no allocation.
+    pin.* = destination;
+    // This explicit placement mutation must invalidate renderer snapshots.
+    storage.markMutated(wrapper.io.io());
     return .success;
 }
 
