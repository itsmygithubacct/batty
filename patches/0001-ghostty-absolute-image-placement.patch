+    try testing.expectEqual(Result.invalid_value, placement_set_position(t, 1, 0, 0, 0));
+    try testing.expectEqual(Result.invalid_value, placement_set_position(t, 1, 1, 80, 0));
+    try testing.expectEqual(Result.invalid_value, placement_set_position(t, 1, 1, 0, 24));
+    try testing.expectEqual(Result.no_value, placement_set_position(t, 2, 1, 0, 0));
