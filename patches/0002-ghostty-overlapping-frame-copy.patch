+/// Move validated RGBA rectangles within one canvas with memmove semantics.
+/// Row order protects vertical overlap; byte order protects horizontal overlap.
+pub fn moveCanvasRect(
+    canvas: []u8,
+    canvas_width: u32,
+    width: u32,
+    height: u32,
+    src_x: u32,
+    src_y: u32,
+    dst_x: u32,
+    dst_y: u32,
+) void {
+    for (0..height) |index| {
+        const row = if (dst_y > src_y) height - 1 - index else index;
+        const dst_off = ((dst_y + row) * @as(usize, canvas_width) + dst_x) * 4;
+        const src_off = ((src_y + row) * @as(usize, canvas_width) + src_x) * 4;
+        const length = @as(usize, width) * 4;
+        const dst = canvas[dst_off..][0..length];
+        const src = canvas[src_off..][0..length];
+        if (dst_off > src_off) std.mem.copyBackwards(u8, dst, src)
+        else std.mem.copyForwards(u8, dst, src);
+    }
+}
