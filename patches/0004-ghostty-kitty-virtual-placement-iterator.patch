+pub fn virtual_placement_next(
+    iter_: VirtualPlacementIterator,
+    out: ?*VirtualPlacementInfo,
+) callconv(lib.calling_conv) bool {
+    if (comptime !build_options.kitty_graphics) return false;
+    const iter = iter_ orelse return false;
+    const info = out orelse return false;
+    if (info.size != @sizeOf(VirtualPlacementInfo) or
+        info.geometry.size != @sizeOf(PlacementRenderInfo)) return false;
+    const t = iter.terminal;
+    const storage = &t.screens.active.kitty_images;
+    while (!iter.relative_phase) {
+        const p = iter.inner.next() orelse {
+            iter.relative_phase = true;
+            break;
+        };
+        const image = storage.imageById(p.image_id) orelse continue;
+        if (image.data.isPending()) continue;
+        const rp = p.renderPlacement(storage, &image, iter.cell_width, iter.cell_height) catch continue;
+        if (rp.dest_width == 0 or rp.dest_height == 0 or
+            rp.source_width == 0 or rp.source_height == 0) continue;
+        const vp = t.screens.active.pages.pointFromPin(.viewport, rp.top_left) orelse continue;
+        info.* = .{
+            .size = @sizeOf(VirtualPlacementInfo),
+            .image_id = p.image_id,
+            .placement_id = p.placement_id,
+            .z = -1,
+            .x_offset = rp.offset_x,
+            .y_offset = rp.offset_y,
+            .geometry = .{
+                .size = @sizeOf(PlacementRenderInfo),
+                .pixel_width = rp.dest_width,
+                .pixel_height = rp.dest_height,
+                .grid_cols = p.width,
+                .grid_rows = p.height,
+                .viewport_col = @intCast(vp.viewport.x),
+                .viewport_row = @intCast(vp.viewport.y),
+                .viewport_visible = true,
+                .source_x = rp.source_x,
+                .source_y = rp.source_y,
+                .source_width = rp.source_width,
+                .source_height = rp.source_height,
+            },
+        };
+        return true;
+    }
+    if (!iter.has_relative) return false;
+    while (iter.relative.next()) |entry| {
+        const p = entry.value_ptr;
+        const rel = switch (p.location) {
+            .relative => |value| value,
+            else => continue,
+        };
+        const chain = storage.resolveChain(rel) orelse continue;
+        if (chain.root.location != .virtual) continue;
+        const origin = iter.origins.get(chain.root_key) orelse continue;
+        const image = storage.imageById(entry.key_ptr.image_id) orelse continue;
+        if (image.data.isPending()) continue;
+        const grid = p.gridSize(image, t);
+        if (grid.cols == 0 or grid.rows == 0) continue;
+        const x: i64 = @as(i64, origin.x) + chain.horizontal_offset;
+        const y: i64 = @as(i64, origin.y) + chain.vertical_offset;
+        if (y >= t.rows or y + grid.rows - 1 < 0 or
+            x >= t.cols or x + grid.cols - 1 < 0) continue;
+        const col = std.math.cast(i32, x) orelse continue;
+        const row = std.math.cast(i32, y) orelse continue;
+        const size = p.pixelSize(image, t);
+        const offset = p.cellOffset(t);
+        const source = p.sourceRect(image);
+        if (size.width == 0 or size.height == 0 or
+            source.width == 0 or source.height == 0) continue;
+        info.* = .{
+            .size = @sizeOf(VirtualPlacementInfo),
+            .image_id = entry.key_ptr.image_id,
+            .placement_id = entry.key_ptr.placement_id.id,
+            .z = p.z,
+            .x_offset = offset.x,
+            .y_offset = offset.y,
+            .geometry = .{
+                .size = @sizeOf(PlacementRenderInfo),
+                .pixel_width = size.width,
+                .pixel_height = size.height,
+                .grid_cols = grid.cols,
+                .grid_rows = grid.rows,
+                .viewport_col = col,
+                .viewport_row = row,
+                .viewport_visible = true,
+                .source_x = source.x,
+                .source_y = source.y,
+                .source_width = source.width,
+                .source_height = source.height,
+            },
+        };
+        return true;
+    }
+    return false;
+}
 
