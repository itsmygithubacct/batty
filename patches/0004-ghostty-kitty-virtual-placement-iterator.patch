+pub fn virtual_placement_iterator_new(
+    terminal_: terminal_c.Terminal,
+    alloc_: ?*const CAllocator,
+    cell_width: u32,
+    cell_height: u32,
+    out: *VirtualPlacementIterator,
+) callconv(lib.calling_conv) Result {
+    out.* = null;
+    if (comptime !build_options.kitty_graphics) return .no_value;
+    const wrapper = terminal_ orelse return .invalid_value;
+    if (cell_width == 0 or cell_height == 0) return .invalid_value;
+    const t = wrapper.terminal;
+    const top = t.screens.active.pages.getTopLeft(.viewport);
+    const bot = t.screens.active.pages.getBottomRight(.viewport) orelse return .invalid_value;
+    const storage = &t.screens.active.kitty_images;
+    const alloc = lib.alloc.default(alloc_);
+    const iter = alloc.create(VirtualPlacementIteratorWrapper) catch return .out_of_memory;
+    iter.* = .{
+        .alloc = alloc,
+        .terminal = t,
+        .inner = kitty_unicode.placementIterator(top, bot),
+        .relative = storage.placements.iterator(),
+        .cell_width = cell_width,
+        .cell_height = cell_height,
+    };
+    var placements = storage.placements.iterator();
+    while (placements.next()) |entry| {
+        const rel = switch (entry.value_ptr.location) {
+            .relative => |value| value,
+            else => continue,
+        };
+        const chain = storage.resolveChain(rel) orelse continue;
+        if (chain.root.location == .virtual) {
+            iter.has_relative = true;
+            break;
+        }
+    }
+    if (iter.has_relative) {
+        var origin_it = kitty_unicode.placementIterator(top, bot);
+        while (origin_it.next()) |p| {
+            const target = storage.placeholderTarget(p.image_id, p.placement_id) orelse continue;
+            const vp = t.screens.active.pages.pointFromPin(.viewport, p.pin) orelse continue;
+            const gop = iter.origins.getOrPut(alloc, target.key) catch {
+                iter.origins.deinit(alloc);
+                alloc.destroy(iter);
+                return .out_of_memory;
+            };
+            const x: u32 = vp.viewport.x;
+            const y: u32 = vp.viewport.y;
+            if (gop.found_existing) {
+                gop.value_ptr.x = @min(gop.value_ptr.x, x);
+                gop.value_ptr.y = @min(gop.value_ptr.y, y);
+            } else gop.value_ptr.* = .{ .x = x, .y = y };
+        }
+    }
+    out.* = iter;
+    return .success;
